# Secretos de las Edge Functions. Copia a supabase/.env (ignorado por git) y súbelos con:
#   supabase secrets set --env-file supabase/.env
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente: no hace falta ponerlos.

# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Remitente. Con dominio verificado en Resend: "Prakisama Mobility <avisos@tudominio.com>".
# Sin dominio verificado solo puedes usar "onboarding@resend.dev" y enviar a tu propio email.
RESEND_FROM=Prakisama Mobility <onboarding@resend.dev>

# Secreto compartido entre pg_cron y la función send-reminders (genera uno largo y aleatorio).
CRON_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# URL pública de la app (para el enlace del email y del calendario)
APP_URL=https://flota.tudominio.com
